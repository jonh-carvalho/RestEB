# Exemplo de Arquivo .env para Produção

## ⚠️ IMPORTANTE
# Este arquivo é um EXEMPLO apenas
# NUNCA comite o arquivo .env real em Git
# Use AWS Beanstalk Environment Variables ou AWS Secrets Manager

# ============================================
# 1. CONFIGURAÇÃO DJANGO CORE
# ============================================

# Chave secreta do Django (GERAR NOVA PARA PRODUÇÃO!)
# Gerar com: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=su@-chave-super-secreta-aqui-64-caracteres-aleatoórios-Xk9mP2lQ8wR5vT3nY1b6

# Django Debug Mode
DJANGO_DEBUG=False

# Django Settings Module
DJANGO_SETTINGS_MODULE=catalogo.settings

# ============================================
# 2. BANCO DE DADOS (RDS MySQL)
# ============================================

# Nome do banco de dados
RDS_DB_NAME=catalogo_production

# Usuário do RDS
RDS_USERNAME=admin

# Senha do RDS (MÍNIMO 16 caracteres com números, letras maiúsculas/minúsculas e símbolos)
RDS_PASSWORD=MyP@ssw0rd!SecureP@ss#2024

# Hostname do RDS
# Formato: seu-nome.xxxxxxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_HOSTNAME=catalogo-db-prod.c9akciq32.us-east-1.rds.amazonaws.com

# Porta do RDS (padrão MySQL é 3306)
RDS_PORT=3306

# ============================================
# 3. HOSTS & DOMÍNIOS
# ============================================

# Hosts permitidos (separados por vírgula)
# IMPORTANTE: Adicionar seu domínio real
DJANGO_ALLOWED_HOSTS=seu-app.elasticbeanstalk.com,seu-dominio.com,www.seu-dominio.com,api.seu-dominio.com

# ============================================
# 4. SEGURANÇA HTTPS & COOKIES
# ============================================

# Forçar HTTPS em produção
DJANGO_SECURE_SSL_REDIRECT=True

# Cookie de sessão seguro (HTTPS only)
# SESSION_COOKIE_SECURE=True (configurado automaticamente)

# Cookie CSRF seguro
# CSRF_COOKIE_SECURE=True (configurado automaticamente)

# HSTS (HTTP Strict Transport Security) - segundos
# 31536000 = 1 ano (máximo recomendado)
DJANGO_SECURE_HSTS_SECONDS=31536000

# Incluir subdomínios na política HSTS
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Permitir pré-carregamento HSTS (chrome preload list)
DJANGO_SECURE_HSTS_PRELOAD=True

# ============================================
# 5. CSRF (Cross-Site Request Forgery)
# ============================================

# Origens CSRF confiáveis (separadas por vírgula)
# Adicionar domínios do frontend/aplicação
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com,https://app.seu-dominio.com

# ============================================
# 6. CORS (Cross-Origin Resource Sharing) [OPCIONAL]
# ============================================

# Se seu frontend está em domínio diferente
# Adicionar apenas se usar django-cors-headers
DJANGO_CORS_ALLOWED_ORIGINS=https://frontend.seu-dominio.com,https://www.seu-dominio.com

# ============================================
# 7. AWS S3 (Armazenamento de Mídia) [OPCIONAL]
# ============================================

# Usar S3 para media files?
USE_S3=False

# Nome do bucket S3 (se USE_S3=True)
# AWS_STORAGE_BUCKET_NAME=seu-bucket-name

# Região AWS S3
# AWS_S3_REGION_NAME=us-east-1

# ============================================
# 8. EMAIL (AWS SES) [OPCIONAL]
# ============================================

# Backend de email
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Host (AWS SES)
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com

# SMTP Port
# EMAIL_PORT=587

# Usar TLS
# EMAIL_USE_TLS=True

# Email SMTP Username (AWS SES username)
# EMAIL_HOST_USER=AKIAIOSFODNN7EXAMPLE

# Email SMTP Password (AWS SES password)
# EMAIL_HOST_PASSWORD=BQoDYXdzEHn...long-token

# Email padrão (From)
# DEFAULT_FROM_EMAIL=noreply@seu-dominio.com

# ============================================
# 9. LOGGING [OPCIONAL]
# ============================================

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# ============================================
# 10. BEANSTALK & AWS
# ============================================

# Environment type
ENVIRONMENT=production

# AWS Region
AWS_DEFAULT_REGION=us-east-1

# ============================================
# 11. APLICAÇÃO
# ============================================

# Timezone (já configurado em settings.py)
# TIME_ZONE=America/Sao_Paulo

# Idioma
# LANGUAGE_CODE=pt-br

# ============================================
# EXEMPLOS DE GERADORES
# ============================================

# Para gerar SECRET_KEY:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

# Para gerar senha forte (Linux/macOS):
# openssl rand -base64 32

# Para gerar senha forte (Python):
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# ============================================
# CHECKLIST DE SEGURANÇA
# ============================================

# ✅ SECRET_KEY é único e forte (mínimo 50 caracteres aleatórios)
# ✅ DEBUG = False
# ✅ RDS_PASSWORD é forte (16+ chars, maiúsculas, minúsculas, números, símbolos)
# ✅ ALLOWED_HOSTS inclui seus domínios reais
# ✅ HTTPS habilitado
# ✅ HSTS habilitado
# ✅ CSRF_TRUSTED_ORIGINS configurado
# ✅ Email credentials (se necessário) estão seguros
# ✅ AWS credentials (se necessário) estão em IAM Role, NÃO aqui
# ✅ Este arquivo NÃO está commitado em Git (.gitignore)
# ✅ Este arquivo está protegido (permissões 600: chmod 600 .env)

# ============================================
# COMO USAR ESTE ARQUIVO
# ============================================

# 1. LOCALMENTE (desenvolvimento):
#    cp .env.example .env
#    Editar .env com valores locais
#    source .env  (ou usar python-dotenv)

# 2. AWS BEANSTALK:
#    eb setenv SECRET_KEY="..." DJANGO_DEBUG="False" ...
#    OU upload arquivo de environment variables:
#    eb create production --envvars-file .env.prod

# 3. AWS SECRETS MANAGER (RECOMENDADO):
#    Usar AWS Secrets Manager para gerenciar secrets
#    Aplicação acessa via boto3

# ============================================
# PRÓXIMOS PASSOS
# ============================================

# 1. Copiar este arquivo e editar com valores REAIS
# 2. Não commitar arquivo .env em Git
# 3. Usar AWS Beanstalk environment variables ou AWS Secrets Manager
# 4. Testare em staging antes de produção
# 5. Rotacionar credenciais regularmente (mensal)

