# =============================
# Django - Variáveis obrigatórias
# =============================
# Gere com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# como gerar uma secret key no command line
# Na pasta do projeto, execute o comando abaixo e copie a saída para a variável abaixo.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=bn=^g5ys&zxpv35j)eyub26sag+l!c@5u6vgh%u+a&zdqyu+6*

# True/False (aceita: 1,true,yes,on)
DJANGO_DEBUG=True

# Hosts permitidos (separados por vírgula)
# Em produção, informe domínio/IP reais
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ibmec.us-east-1.elasticbeanstalk.com

# Origens confiáveis para CSRF (separadas por vírgula)
# Exemplo produção: https://meusite.com,https://www.meusite.com
# Em produção, informe os domínios reais, ex: https://meusite.com,https://www.meusite.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ibmec.us-east-1.elasticbeanstalk.com,http://ibmec.us-east-1.elasticbeanstalk.com

# Segurança HTTPS em produção
# Em produção, defina como True e configure um certificado SSL válido.
DJANGO_SECURE_SSL_REDIRECT=False
# Tempo em segundos para HSTS (HTTP Strict Transport Security). Em produção, defina um valor maior, ex: 31536000 (1 ano).
DJANGO_SECURE_HSTS_SECONDS=31536000


# =============================
# Banco local MySQL (opcional)
# =============================
# Se todos os 4 campos abaixo forem preenchidos e DJANGO_DEBUG=True,
# o projeto usa MySQL local.
MYSQL_DATABASE=catalogo
MYSQL_USER=root
MYSQL_PASSWORD=admin   
MYSQL_HOST=localhost
MYSQL_PORT=3306


# =============================
# Banco produção AWS RDS (obrigatório em produção)
# =============================
# Necessário quando DJANGO_DEBUG=False
RDS_DB_NAME=ebdb
RDS_USERNAME=ebroot
RDS_PASSWORD=password
RDS_HOSTNAME=awseb-e-7d2rwd5p2v-stack-awsebrdsdatabase-6hhlwd1je5xp.co5oce4wazh1.us-east-1.rds.amazonaws.com
RDS_PORT=3306


# =============================
# Armazenamento de mídia
# =============================
# Mantido para compatibilidade futura no settings
USE_S3=False
