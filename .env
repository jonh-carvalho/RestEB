# Hosts permitidos (separados por vírgula)
# Em produção, informe domínio/IP reais
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ibmec.us-east-1.elasticbeanstalk.com

# Origens confiáveis para CSRF (separadas por vírgula)
# Exemplo produção: https://meusite.com,https://www.meusite.com
# Em produção, informe os domínios reais, ex: https://meusite.com,https://www.meusite.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ibmec.us-east-1.elasticbeanstalk.com,http://ibmec.us-east-1.elasticbeanstalk.com

# Segurança HTTPS em produção
# Em produção, defina como True e configure um certificado SSL válido.
DJANGO_SECURE_SSL_REDIRECT=False
