# Garante que o EB use a plataforma Python correta (AL2/AL2023).
# Nenhuma configuracao adicional necessaria aqui; a plataforma e selecionada
# ao criar o environment no console AWS com "Python 3.12 running on 64bit Amazon Linux 2023".
option_settings:
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: /var/app/current:$PYTHONPATH
